#!/bin/bash


if [ "$XDG_SESSION_TYPE" = "wayland" ]; then
    OUT=$(printf "Suspend\\nShutdown\\nReboot\\nHibernate" | wmenu -i -l 4)
else
    OUT=$(printf "Suspend\\nShutdown\\nReboot\\nHibernate" | dmenu -i -l 4)
fi

if [ "$OUT" == "Shutdown" ]; then
    systemctl poweroff
elif [ "$OUT" == "Reboot" ]; then
    systemctl reboot
elif [ "$OUT" == "Suspend" ]; then
    if grep 1 /sys/class/power_supply/AC/online >/dev/null; then
        if [ "$XDG_SESSION_TYPE" = "wayland" ]; then
            swaylock -f -c 000000; wlopm --off "*"; swayidle -w timeout 1 '' resume 'wlopm --on "*"; kill ${PPID}' before-sleep ''
        else
            xset dpms force off
        fi
    else
        systemctl suspend
    fi
elif [ "$OUT" == "Hibernate" ]; then
    systemctl hibernate
fi
