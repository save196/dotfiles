#!/bin/bash
vol=$(get-volume)
[[ -z "$vol" ]] && exit 1

bticon=$(wpctl inspect @DEFAULT_AUDIO_SINK@ | grep -q 'node.name = "bluez' && echo " ")

if [ "$vol" -gt 70 ]; then
  icon=" "
elif [ "$vol" -lt 30 ]; then
  icon=" "
else
  icon=" "
fi

if wpctl get-volume @DEFAULT_AUDIO_SINK@ | grep -q '\[MUTED\]'; then
  icon="❗"
fi

echo "$icon$vol%$bticon"
