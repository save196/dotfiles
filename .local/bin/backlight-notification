#!/bin/bash

BRIGHTNESS=$(
    case "$1" in
        inc)
            brightnessctl -m set +5%
            ;;
        dec)
            brightnessctl -m -n1 set 5%-
            ;;
        *)
            brightnessctl -m i
            ;;
    esac | grep -oP '[0-9]+(?=%)'
)

notify-send " Backlight: $BRIGHTNESS%" -t 4000 -a "backlight-notification" -h string:x-canonical-private-synchronous:backlight -h int:value:"$BRIGHTNESS" &
