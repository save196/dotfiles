#!/usr/bin/env python3
import argparse
import subprocess
import time
import uuid

from jeepney import HeaderFields, MatchRule, MessageType, new_error, new_method_return
from jeepney.bus_messages import message_bus
from jeepney.io.blocking import open_dbus_connection

SERVER_NAME = "org.freedesktop.ScreenSaver"


class ScreenSaverService:
    def __init__(self):
        self.inhibitions = {}  # cookie -> sender

    def inhibit(self, sender):
        cookie = int(uuid.uuid4()) & 0xFFFFFFFF
        self.inhibitions[cookie] = sender
        if len(self.inhibitions) == 1:
            subprocess.run(["xset", "s", "off", "-dpms"], check=False)
            subprocess.run(["xautolock", "-disable"], check=False)
        return cookie

    def uninhibit(self, cookie):
        if cookie in self.inhibitions:
            self.inhibitions.pop(cookie)
            self.release_if_idle()

    def drop_sender(self, sender):
        dead = [c for c, s in self.inhibitions.items() if s == sender]
        for cookie in dead:
            self.inhibitions.pop(cookie)
        if dead:
            self.release_if_idle()

    def release_if_idle(self):
        if not self.inhibitions:
            subprocess.run(["xset", "s", "on", "+dpms"], check=False)
            subprocess.run(["xautolock", "-enable"], check=False)

    def update_xautolock(self, suspend_time):
        if not suspend_time or suspend_time < 1:
            suspend_time = 60
        subprocess.run(["xautolock", "-exit"], check=False)
        time.sleep(1)
        subprocess.Popen(
            ["xautolock", "-time", str(suspend_time), "-locker", "systemctl suspend"]
        )


def main():
    parser = argparse.ArgumentParser(description="Custom Screen Saver Service")
    parser.add_argument(
        "--suspend-time", type=int, help="Time in minutes before suspend"
    )
    args = parser.parse_args()

    service = ScreenSaverService()
    with open_dbus_connection() as connection:
        name_reply = connection.send_and_get_reply(message_bus.RequestName(SERVER_NAME))
        if name_reply.body[0] != 1:
            if args.suspend_time:
                service.update_xautolock(args.suspend_time)
            return

        connection.send_and_get_reply(
            message_bus.AddMatch(
                MatchRule(
                    type="signal",
                    sender="org.freedesktop.DBus",
                    interface="org.freedesktop.DBus",
                    member="NameOwnerChanged",
                    path="/org/freedesktop/DBus",
                )
            )
        )

        subprocess.Popen(["xss-lock", "--", "slock"])
        service.update_xautolock(args.suspend_time)

        while True:
            msg = connection.receive()
            fields = msg.header.fields
            method = fields.get(HeaderFields.member)
            if msg.header.message_type == MessageType.signal:
                if method == "NameOwnerChanged" and not msg.body[2]:
                    service.drop_sender(msg.body[0])
                continue
            if msg.header.message_type != MessageType.method_call:
                continue
            if method == "Inhibit":
                cookie = service.inhibit(fields.get(HeaderFields.sender))
                rep = new_method_return(msg, "u", (cookie,))
            elif method == "UnInhibit":
                if msg.body:
                    service.uninhibit(msg.body[0])
                rep = new_method_return(msg, "", ())
            else:
                rep = new_error(msg, SERVER_NAME + ".Error.NoMethod")
            connection.send_message(rep)


if __name__ == "__main__":
    main()
