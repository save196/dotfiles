#!/bin/bash

VOLUME=$(get-volume)

if [ "$1" = "inc" ] && [ "$VOLUME" -ne 100 ]; then
    if [ $((VOLUME + 10)) -gt 100 ]; then
        wpctl set-volume @DEFAULT_AUDIO_SINK@ 1.0
    else
        wpctl set-volume @DEFAULT_AUDIO_SINK@ 10%+
    fi
elif [ "$1" = "dec" ]; then
    wpctl set-volume @DEFAULT_AUDIO_SINK@ 10%-
elif [ "$1" = "tog" ]; then
    wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
elif [ "$1" = "mic-tog" ]; then
    wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
fi

VOLUME=$(get-volume)

if [ "$1" = "inc" ] || [ "$1" = "dec" ] || [ "$1" = "tog" ]; then
    ICON=""
    wpctl get-volume @DEFAULT_AUDIO_SINK@ | grep -q MUTED && ICON=""
    notify-send "$ICON Volume: $VOLUME%" -t 4000 -a "audio-notification" -h string:x-canonical-private-synchronous:volume -h int:value:"$VOLUME" &
fi

pkill -RTMIN+10 dw.blocks
